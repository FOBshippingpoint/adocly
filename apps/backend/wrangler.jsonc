{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adocly-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "R2_BUCKET_NAME": "adocly-assets" },
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "adocly-assets" }],
  "durable_objects": {
    "bindings": [{ "name": "SYNC", "class_name": "SyncServer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncServer"] }],
}
